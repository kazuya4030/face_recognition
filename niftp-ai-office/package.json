{
  "name": "niftp-ai-office",
  "version": "0.1.0",
  "private": true,
  "description": "NIFTP AI Office — CEOがAI社員に仕事を依頼・管理するローカルWebアプリ（初期版）",
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --clear-screen=false server/src/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx server/src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs",
    "backup": "tsx server/src/ops/cli.ts backup",
    "backup:verify": "tsx server/src/ops/cli.ts verify",
    "restore": "tsx server/src/ops/cli.ts restore",
    "doctor": "tsx server/src/ops/cli.ts doctor"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "fastify": "^5.12.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
